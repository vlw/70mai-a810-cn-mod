# Build configuration. Copy to config.env and edit; config.env overrides these values.
# 1 = on, 0 = off.

# --- main_app (user interface) ---
LANGUAGE_MENU=1      # "System language" item in System settings (instead of "Download App"); needs the WW image
TIMEZONE_MENU=1      # time zone choice on the System time page (item 0 while GPS time sync is on)
DEFAULT_ENGLISH=1    # English instead of Chinese after a factory reset (needs LANGUAGE_MENU)
DEFAULT_TZ=+3        # factory time zone, e.g. +3, -5, +5:30; empty = stock UTC+8
GPS_HOME=1           # home screen: GPS icon (dim while searching) and speed under the clock
RU_LABELS=1          # Russian menu: "Формат видео", "Высокое сжатие (HEVC)", "Низкое сжатие (AVC)"

# --- video ---
HLG=1                # HLG (HDR) video in the HDR modes of the front camera: tone curve + colour tag

# --- system ---
TELNET=1             # root telnet without a password on the camera Wi-Fi (192.168.0.1:23)
GPS_WARM=1           # GNSS warm start: feeds time and last position to the GPS module after each load
VOICE_RU_EN=1        # Russian and English voice prompts from the WW image
UPDATE_SCREEN_EN=1   # English screens while flashing from the SD card (U-Boot reads the DTB)
